# Copy this file to .env and fill in your own values.
# Never commit the real .env file to git.

# --- Bot API (from @BotFather) ---
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_OWN_BOT_TOKEN

# --- Telegram API (from https://my.telegram.org) ---
API_ID=REPLACE_WITH_YOUR_OWN_API_ID
API_HASH=REPLACE_WITH_YOUR_OWN_API_HASH

# Name of the local .session file used by the Telethon account that
# powers the forward engine. Created the first time you run:
#   python -m core.authorize
SESSION_NAME=ChannelFlow

# Optional: set this INSTEAD of relying on the local .session file when
# deploying to a host with an ephemeral filesystem (Render, Railway,
# Heroku, ...). Generate it locally with:
#   python -m core.export_session
SESSION_STRING=

# SQLite database file path
DB_NAME=channelflow.db

# Comma-separated Telegram user ids allowed to use /admin
ADMIN_IDS=REPLACE_WITH_YOUR_OWN_TELEGRAM_USER_ID
